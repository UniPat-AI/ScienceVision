{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/export_task.schema.json",
  "description": "Solver-safe export. It deliberately excludes answers, reasoning, seeds, and private provenance.",
  "type": "object",
  "required": ["artifact_kind", "task_id", "prompt", "anonymous_scene_ref", "viewer_session_request"],
  "properties": {
    "artifact_kind": {"const": "solver_safe_export"},
    "task_id": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "anonymous_scene_ref": {"type": "string", "minLength": 1},
    "viewer_session_request": {
      "type": "object",
      "required": ["request_id", "viewer_profile_digest", "allowed_operations"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "viewer_profile_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "allowed_operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      {"required": ["reference_answer"]},
      {"required": ["reasoning"]},
      {"required": ["seed_refs"]},
      {"required": ["private_provenance"]},
      {"required": ["real_asset_id"]},
      {"required": ["asset_path"]}
    ]
  },
  "additionalProperties": false
}
