{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/selection.schema.json",
  "description": "Immutable ScienceVision eval-v32 selection input. This is an author-side source record, never a solver projection.",
  "type": "object",
  "required": [
    "bundle",
    "domains",
    "generated_by",
    "id_sha256",
    "overrides",
    "per_domain",
    "schema_version",
    "seed",
    "total",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "sciencevision.eval_v32_selection.v1"},
    "generated_by": {"type": "string", "minLength": 1},
    "seed": {"type": "string", "minLength": 1},
    "per_domain": {"type": "integer", "minimum": 1},
    "overrides": {"type": "object"},
    "total": {"type": "integer", "minimum": 1},
    "id_sha256": {"$ref": "#/definitions/raw_sha256"},
    "warnings": {"type": "array"},
    "bundle": {
      "type": "object",
      "required": ["package_id", "path"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/domain_selection"}
    }
  },
  "additionalProperties": false,
  "definitions": {
    "raw_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "required": ["bytes", "path", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/raw_sha256"},
        "format": {"type": "string", "minLength": 1},
        "mask_id": {"type": "integer", "minimum": 0},
        "mask_selection": {"const": "label_index"}
      },
      "additionalProperties": false
    },
    "selection_row": {
      "type": "object",
      "required": [
        "access_track",
        "answer_fields",
        "compute_packages",
        "difficulty",
        "domain",
        "forbidden_strategies",
        "has_compute_contract",
        "mask_asset",
        "mcp_allow_list",
        "primary_asset",
        "question_id",
        "sub_domain",
        "task_id",
        "viewer",
        "vision_class_code",
        "vision_class_group"
      ],
      "properties": {
        "access_track": {"enum": ["raw_compute", "viewer_measurement"]},
        "answer_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "compute_packages": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "difficulty": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "forbidden_strategies": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "has_compute_contract": {"type": "boolean"},
        "mask_asset": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/asset"}]},
        "mcp_allow_list": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "primary_asset": {"$ref": "#/definitions/asset"},
        "question_id": {"type": "string", "minLength": 1},
        "sub_domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "task_id": {"type": "string", "minLength": 1},
        "viewer": {"type": "string", "minLength": 1},
        "vision_class_code": {"type": "string", "minLength": 1},
        "vision_class_group": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "domain_selection": {
      "type": "object",
      "required": [
        "by_sub_domain",
        "count",
        "exposure",
        "id_sha256",
        "question_ids",
        "quota",
        "rows",
        "sub_domain_population"
      ],
      "properties": {
        "by_sub_domain": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "count": {"type": "integer", "minimum": 1},
        "exposure": {"type": "object"},
        "id_sha256": {"$ref": "#/definitions/raw_sha256"},
        "question_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "quota": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/selection_row"}},
        "sub_domain_population": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    }
  }
}
