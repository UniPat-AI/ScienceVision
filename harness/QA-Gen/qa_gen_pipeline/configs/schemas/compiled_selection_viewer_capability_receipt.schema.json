{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/compiled_selection_viewer_capability_receipt.schema.json",
  "description": "Human-approved binding of one compiled-selection slot, static capability profile, and least-privilege viewer operation set.",
  "type": "object",
  "required": [
    "schema_version", "kind", "id", "decision", "reviewer", "reviewed_at",
    "mapping_id", "mapping_digest", "profile_id", "profile_digest", "slot_digest",
    "source_access_track", "generation_strategy", "target_leaf", "source_viewer",
    "source_hint_digest", "asset_formats", "viewer_family", "viewer_lock_content_digest",
    "allowed_operations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_compiled_selection_viewer_capability_receipt"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "decision": {"const": "approved"},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "mapping_id": {"type": "string", "minLength": 1},
    "mapping_digest": {"$ref": "#/definitions/digest"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_digest": {"$ref": "#/definitions/digest"},
    "slot_digest": {"$ref": "#/definitions/digest"},
    "source_access_track": {"enum": ["raw_compute", "viewer_measurement"]},
    "generation_strategy": {"enum": ["preserve_intent", "reauthor_on_asset"]},
    "target_leaf": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "source_viewer": {"type": "string", "minLength": 1},
    "source_hint_digest": {"$ref": "#/definitions/digest"},
    "asset_formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "viewer_family": {"enum": ["molstar", "niivue"]},
    "viewer_lock_content_digest": {"$ref": "#/definitions/digest"},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false,
  "definitions": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
