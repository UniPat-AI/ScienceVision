{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/question_text_policy.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "enforcement", "coverage"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_question_text_policy"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "enforcement": {
      "type": "object",
      "required": ["reject_solver_ui_meta_language", "require_question_contract", "forbidden_categories"],
      "properties": {
        "reject_solver_ui_meta_language": {"const": true},
        "require_question_contract": {"const": true},
        "forbidden_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "viewer_tool_instruction_en",
              "viewer_scene_operation_en",
              "ui_control_reference_en",
              "solver_shortcut_reference_en",
              "viewer_axis_reference_en",
              "viewer_tool_instruction_zh",
              "viewer_scene_operation_zh",
              "ui_control_reference_zh",
              "viewer_axis_reference_zh"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "measurement_max_fraction",
        "reasoning_min_fraction",
        "domain_minimum_expected_count",
        "approved_override_required"
      ],
      "properties": {
        "measurement_max_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "reasoning_min_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "domain_minimum_expected_count": {"type": "integer", "minimum": 1},
        "approved_override_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
