{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/subdomain_aliases.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "id", "version", "aliases"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_subdomain_aliases"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_leaf", "target_leaf"],
        "properties": {
          "source_leaf": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
          "target_leaf": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
