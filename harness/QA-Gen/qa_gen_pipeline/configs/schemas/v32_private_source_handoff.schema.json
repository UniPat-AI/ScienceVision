{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/v32_private_source_handoff.schema.json",
  "description": "Private agent handoff index for V32 source records; references are opaque and stage-scoped.",
  "type": "object",
  "required": ["source_import_digest", "records"],
  "properties": {
    "source_import_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_digest", "author_brief_digest", "truth_mode", "agent_inputs"],
        "properties": {
          "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "author_brief_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "truth_mode": {"enum": ["attested_compute_recompute", "viewer_evidence_required"]},
          "agent_inputs": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
