{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/v32_sanitized_author_brief.schema.json",
  "description": "Author-safe V32 source projection. It intentionally excludes historical text, answers, source IDs, paths, compute contracts, and solving hints.",
  "type": "object",
  "required": [
    "source_record_digest",
    "target_leaf",
    "anonymous_target_descriptor",
    "answer_shape",
    "allowed_viewer_operations",
    "generation_strategy",
    "constraints"
  ],
  "properties": {
    "source_record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target_leaf": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "anonymous_target_descriptor": {
      "type": "object",
      "required": ["scene_kind", "asset_roles"],
      "properties": {
        "scene_kind": {"enum": ["molecular_structure", "volumetric_image", "three_dimensional_scene"]},
        "asset_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["primary", "mask"]}}
      },
      "additionalProperties": false
    },
    "answer_shape": {
      "type": "object",
      "required": ["kind", "fields"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "allowed_viewer_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generation_strategy": {"enum": ["reauthor_on_asset", "preserve_intent"]},
    "constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
