{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/v32_private_source_spec.schema.json",
  "description": "Pinned V32 source-bundle policy used only by the private source adapter.",
  "type": "object",
  "required": ["schema_version", "kind", "id", "selection", "bundle", "compute_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_v32_private_source_spec"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "selection": {
      "type": "object",
      "required": ["schema_version", "file_sha256", "id_sha256", "total", "domain_counts"],
      "properties": {
        "schema_version": {"const": "sciencevision.eval_v32_selection.v1"},
        "file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "total": {"type": "integer", "minimum": 1},
        "domain_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "bundle": {
      "type": "object",
      "required": [
        "manifest_filename",
        "manifest_sha256",
        "manifest_schema_version",
        "package_id",
        "checksums_filename",
        "question_assets",
        "answer_keys",
        "max_asset_bytes"
      ],
      "properties": {
        "manifest_filename": {"const": "MANIFEST.json"},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest_schema_version": {"const": "sciencevision.question_assets_bundle_manifest.v1"},
        "package_id": {"type": "string", "minLength": 1},
        "checksums_filename": {"const": "SHA256SUMS"},
        "question_assets": {"$ref": "#/definitions/role"},
        "answer_keys": {"$ref": "#/definitions/role"},
        "max_asset_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "compute_policy": {
      "type": "object",
      "required": ["allowed_capabilities", "allowed_packages", "allowed_runtimes"],
      "properties": {
        "allowed_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+==[A-Za-z0-9_.+-]+$"}
        },
        "allowed_runtimes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "role": {
      "type": "object",
      "required": ["filename", "sha256", "schema_version"],
      "properties": {
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.jsonl$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
