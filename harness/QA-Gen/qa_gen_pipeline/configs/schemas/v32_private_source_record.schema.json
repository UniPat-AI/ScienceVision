{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/v32_private_source_record.schema.json",
  "description": "Private-only body for an attested historical V32 source record. Never place this in a solver or author bundle.",
  "type": "object",
  "required": [
    "selection",
    "bundle",
    "source_identity",
    "source_access_track",
    "target_leaf",
    "assets",
    "truth_input",
    "legacy_regression"
  ],
  "properties": {
    "selection": {"type": "object"},
    "bundle": {"type": "object"},
    "source_identity": {"type": "object"},
    "source_access_track": {"enum": ["raw_compute", "viewer_measurement"]},
    "target_leaf": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "assets": {"type": "array", "minItems": 1},
    "truth_input": {"type": "object"},
    "legacy_regression": {"type": "object"}
  },
  "additionalProperties": false
}
