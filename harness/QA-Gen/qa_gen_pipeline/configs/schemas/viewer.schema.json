{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/viewer.schema.json",
  "type": "object",
  "required": ["schema_version", "kind", "fixture", "fixture_payload", "fixture_payload_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_viewer_definition_fixture"},
    "fixture": {
      "type": "object",
      "required": ["local_only", "production_eligible"],
      "properties": {
        "local_only": {"type": "boolean"},
        "production_eligible": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"local_only": {"const": true}}, "required": ["local_only"]},
          "then": {"properties": {"production_eligible": {"const": false}}}
        }
      ]
    },
    "fixture_payload": {
      "type": "object",
      "required": ["viewer_id", "capabilities", "forbidden_capabilities", "session_scope_mode"],
      "properties": {
        "viewer_id": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_capabilities": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "session_scope_mode": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {"properties": {"forbidden_capabilities": {"contains": {"const": "network"}}}},
        {"properties": {"forbidden_capabilities": {"contains": {"const": "asset_file_read"}}}},
        {"properties": {"forbidden_capabilities": {"contains": {"const": "raw_asset_metadata"}}}},
        {"properties": {"forbidden_capabilities": {"contains": {"const": "raw_asset_read"}}}},
        {"properties": {"forbidden_capabilities": {"contains": {"const": "arbitrary_compute"}}}},
        {"properties": {"forbidden_capabilities": {"contains": {"const": "unrestricted_compute"}}}}
      ]
    },
    "fixture_payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
