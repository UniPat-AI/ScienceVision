{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qagen/ground_truth_registry.schema.json",
  "description": "A private, human-approved membership registry for candidate reference answers.",
  "type": "object",
  "required": ["schema_version", "kind", "id", "source_status", "record_count"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "qagen_ground_truth_registry"},
    "id": {"type": "string", "minLength": 1},
    "source_status": {"enum": ["missing", "pending_approval", "approved"]},
    "record_count": {"type": "integer", "minimum": 0},
    "approved_snapshot": {
      "type": "object",
      "required": ["records"],
      "properties": {
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_type",
              "source_id",
              "source_digest",
              "record_id",
              "record_digest",
              "answer_digest"
            ],
            "properties": {
              "source_type": {
                "enum": [
                  "expert_annotation",
                  "curated_source_label",
                  "rule_evaluated_structure",
                  "paired_comparison",
                  "measurement_receipt"
                ]
              },
              "source_id": {"type": "string", "minLength": 1},
              "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "record_id": {"type": "string", "minLength": 1},
              "record_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "answer_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "allowed_answer_schema": {
                "description": "The answer form the selected job may emit. It contains no answer value.",
                "type": "object",
                "required": ["shape", "fields"],
                "properties": {
                  "shape": {"type": "string", "minLength": 1},
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                },
                "additionalProperties": false
              },
              "measurement_receipt_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "anonymous_scene_ref": {"type": "string", "minLength": 1},
              "primary_asset_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "selection_slot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {"properties": {"source_type": {"const": "measurement_receipt"}}, "required": ["source_type"]},
                "then": {"required": ["measurement_receipt_digest"]},
                "else": {"not": {"required": ["measurement_receipt_digest"]}}
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"source_status": {"const": "approved"}}, "required": ["source_status"]},
      "then": {"required": ["approved_snapshot"]},
      "else": {"not": {"required": ["approved_snapshot"]}}
    }
  ]
}
