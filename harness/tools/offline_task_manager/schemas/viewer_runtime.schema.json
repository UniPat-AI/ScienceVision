{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sciencevision.viewer_runtime.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loader_api", "files_sha256", "files", "file_count", "byte_size", "entrypoint", "renderers", "capabilities", "capability_evidence", "runtime_id"],
  "properties": {
    "schema_version": {"const": "sciencevision.viewer_runtime.v1"},
    "loader_api": {"const": "sciencevision.viewer_loader.v1"},
    "files_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_size"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "file_count": {"type": "integer", "minimum": 1},
    "byte_size": {"type": "integer", "minimum": 1},
    "entrypoint": {"const": "index.html"},
    "renderers": {"type": "array", "items": {"type": "string"}},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "capability_evidence": {"type": "object"},
    "runtime_id": {"type": "string", "pattern": "^vrt_[0-9a-f]{24}$"}
  }
}
