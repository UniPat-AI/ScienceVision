# Prebuilt image for the raw-asset Codex baseline (sci3d-codex).
# Harbor skips its network installer when `codex` is already on PATH.
FROM node:22-slim

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl bash procps ca-certificates ripgrep python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Pin the CLI, and pin it to the version the evaluation intends to measure.
#
# 0.147.0 sends an `additional_tools` input item declaring its tool namespaces,
# and the `functions` namespace carries description:"". The UniAPI provider's
# upstream answers 502 Bad Gateway to any request containing a namespace group
# with a blank description, deterministically. The fix is the in-container repair
# shim staged by the run's Codex adapter (uniapi_shim.js), which fills the blank
# description and forwards everything else unchanged -- not a downgrade. 0.146.0
# also works, because it does not send that item, and is kept as a fallback tag;
# but it is a different agent than the one under test.
#
# Pinned rather than floating because an unpinned install tracks whatever npm
# publishes, and this failure mode is silent: the trials still run, still get
# scored, and the score is always 0.0 with parse_error=missing_answer.
ARG CODEX_CLI_VERSION=0.147.0
RUN npm install -g "@openai/codex@${CODEX_CLI_VERSION}" && codex --version

# Raw-asset inspection only. Rendering libraries and the MCP server are omitted.
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN pip3 install --no-cache-dir \
        --index-url "${PIP_INDEX_URL}" --trusted-host "${PIP_TRUSTED_HOST}" \
        nibabel trimesh numpy scipy scikit-image Pillow matplotlib

WORKDIR /app
