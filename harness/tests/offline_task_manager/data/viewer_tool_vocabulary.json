    "captured": "2026-08-20",
    "why": "The viewer declares its own functions and the workspace only receives them at runtime, from a repository this one does not contain. This is a snapshot of that vocabulary, kept so the Chinese wording for it can be pinned by a test. It is not the contract: the viewer is."
  },
  "viewers": {
    "molstar": [
      {
        "name": "viewer_rotate",
        "description": "Increment the molecular camera azimuth, elevation, and roll in degrees around its current target.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "d_azimuth_deg": {
              "type": "number"
            },
            "d_elevation_deg": {
              "type": "number"
            },
            "d_roll_deg": {
              "type": "number",
              "default": 0
            }
          },
          "required": [
            "d_azimuth_deg",
            "d_elevation_deg"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "viewer_zoom",
        "description": "Multiply camera zoom; factor > 1 moves closer and factor < 1 moves farther away.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "factor": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 20
            }
          },
          "required": [
            "factor"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "viewer_measure_distance",
        "description": "Resolve two unambiguous atom selectors, draw a Mol* distance annotation, and return the distance in angstroms.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "a": {
              "type": "object",
              "description": "First atom selector; it must resolve to exactly one displayed atom.",
              "properties": {
                "structure_id": {
                  "type": "string",
                  "description": "Stable ID returned by viewer_get_state."
                },
                "structure_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "model_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based model index within the structure."
                },
                "unit_id": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Mol* unit ID, useful when assembly copies are ambiguous."
                },
                "chain_id": {
                  "type": "string",
                  "description": "auth_asym_id or label_asym_id."
                },
                "residue_number": {
                  "type": "integer",
                  "description": "auth_seq_id or label_seq_id."
                },
                "insertion_code": {
                  "type": "string"
                },
                "residue_name": {
                  "type": "string",
                  "description": "auth_comp_id or label_comp_id."
                },
                "atom_name": {
                  "type": "string",
                  "description": "auth_atom_id or label_atom_id."
                },
                "altloc": {
                  "type": "string",
                  "description": "Alternate-location ID; use an empty string for the blank conformer."
                }
              },
              "additionalProperties": false
            },
            "b": {
              "type": "object",
              "description": "Second atom selector; it must resolve to exactly one displayed atom.",
              "properties": {
                "structure_id": {
                  "type": "string",
                  "description": "Stable ID returned by viewer_get_state."
                },
                "structure_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "model_index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Zero-based model index within the structure."
                },
                "unit_id": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Mol* unit ID, useful when assembly copies are ambiguous."
                },
                "chain_id": {
                  "type": "string",
                  "description": "auth_asym_id or label_asym_id."
                },
                "residue_number": {
                  "type": "integer",
                  "description": "auth_seq_id or label_seq_id."
                },
                "insertion_code": {
                  "type": "string"
                },
                "residue_name": {
                  "type": "string",
                  "description": "auth_comp_id or label_comp_id."
                },
                "atom_name": {
                  "type": "string",
                  "description": "auth_atom_id or label_atom_id."
                },
                "altloc": {
                  "type": "string",
                  "description": "Alternate-location ID; use an empty string for the blank conformer."
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "a",
            "b"
          ],
          "additionalProperties": false
        }
      },
      {
